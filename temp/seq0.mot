LOOP

COMMENT

Launching sequence for tmot5
in progress testing version

ENDCOMMENT

INIT



	DDS1 [0]				(2)
	
	DDS5 [0]				(14)

ENDINIT

INNER

## Sequence to ckeck the signal of AOM 3D UP and AOM 3D DOWN ##


+1us  syncc = OFF					(55)

##################################
#            3D MOT              #107840000
##################################

#TURN ON SHIM FIELDS AND 3D MOT MAGNETS#
+2931.3us Bais_coils_X=5.12			(31)#7.128 7.1 5.10 5.12
